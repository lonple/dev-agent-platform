DAP_INTERNAL_TOKEN=dev-internal-token
DAP_SERVER_BASE_URL=http://127.0.0.1:8200
# DeepSeek（OpenAI 兼容，须含 /v1）。
# start-dev 会把下列 LLM_* 注入 backend，代码评审分片与 agent 共用同一套，无需再配 DAP_REVIEW_LLM_*：
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-flash
# 可选更强：deepseek-v4-pro
# LLM_MODEL=deepseek-v4-pro
# 其它兼容网关示例（阿里云）：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.6-flash
# 流式相邻 chunk 最长空闲秒数（默认 600）；0=关闭。
# LLM_STREAM_CHUNK_TIMEOUT_S=600
HOST=0.0.0.0
PORT=8202
